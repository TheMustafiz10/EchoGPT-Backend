
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"


DATABASE_URL: postgresql://postgres:postgres@postgres:5432/echogpt?schema=public

# JWT
JWT_ACCESS_SECRET="replace-with-random-64-char-hex"
JWT_REFRESH_SECRET="replace-with-different-random-64-char-hex"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Encryption
ENCRYPTION_KEY="replace-with-64-char-hex"

PORT=3000
CORS_ORIGIN="chrome-extension://your-extension-id"


# Web Search (Not Implemented)
SERPAPI_API_KEY=""


# Replace with the Real One
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GEMINI_API_KEY="AIza..."

# Email / SMTP (for email verification)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
APP_URL="http://localhost:3000"
